{
  "env": {
    "CLAUDE_HANDOFF_MODEL": "claude-opus-5[1m]"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/sync.sh\"",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/inject-global-memory.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/inject-ops-lanes.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|Agent|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/dotfiles/claude/hooks/context-watchdog.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/dotfiles/claude/hooks/context-watchdog.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/hooks/notification-event.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/hooks/stop-event.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/claude/sync-memories.sh\" >/dev/null 2>&1 || true",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "claude-mem@thedotmack": false,
    "frontend-design@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoCompactWindow": 200000,
  "showClearContextOnPlanAccept": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "precomputeCompactionEnabled": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false
}
