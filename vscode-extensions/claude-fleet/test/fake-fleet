#!/usr/bin/env bash
# Deterministic stand-in for `fleet` so the GROUPING tests do not depend on how
# many background sessions happen to be alive on this machine. It speaks the
# same TSV contract as `fleet ids`:
#   short <TAB> state <TAB> reachable <TAB> ageMin <TAB> cwd <TAB> name
#
# FAKE_FLEET_MODE drives the two roster shapes that are otherwise unreachable on
# a machine that always has sessions running:
#   empty  a SUCCESSFUL run that lists nothing  -> the "no live sessions" notice
#   fail   a nonzero exit with a stderr message -> the error path
#
# FAKE_FLEET_ROWS sets the roster SIZE (default 8). A fixture of one fixed size
# cannot see a production cap: capping the roster read at 8 rows left every test
# green while three of this machine's eleven live sessions vanished. Sizes 1,
# `panes`, `panes`+1 and 13 are all exercised.
#
# FAKE_FLEET_DUPS=1 makes rows 2 and 3 share one name, for the pane-label
# disambiguation that is the only identifier surviving the picker's repaint.
# FAKE_FLEET_DUPS=edge shares the name between the FIRST and LAST rows instead:
# the duplicate count is taken over the whole roster, and a count that quietly
# dropped the tail row was invisible while the twins sat in the middle.
#
# FAKE_FLEET_ARGV names a file that receives one line per invocation holding the
# argv, so a test can see what the extension ASKED the roster (notably which cutoff)
# and compare it with what the panes were then told.
#
# FAKE_FLEET_SLEEP delays the reply, so a test can decide which of two overlapping
# roster reads completes first instead of racing the scheduler.
#
# FAKE_FLEET_UNREACH is a comma-separated list of 1-based row numbers that have NO
# live socket. Those rows carry `0` in the reachable column, and are DROPPED when
# the caller passes --reachable -- which is what the real `fleet ids --reachable`
# does. Without this every fixture row was reachable, so asking for the flag and
# forgetting it returned the same eight rows and the flag pinned only its own argv.
[ -n "${FAKE_FLEET_ARGV:-}" ] && printf '%s\n' "$*" >> "$FAKE_FLEET_ARGV"
[ -n "${FAKE_FLEET_SLEEP:-}" ] && sleep "$FAKE_FLEET_SLEEP"
[ "${1:-}" = ids ] || { echo "fake-fleet: unexpected argv: $*" >&2; exit 3; }
case "${FAKE_FLEET_MODE:-}" in
  empty) exit 0 ;;
  fail)  echo "fake-fleet: the daemon socket is gone" >&2; exit 7 ;;
esac
max=0
want_reach=0
while [ $# -gt 0 ]; do
  case "$1" in
    --max) max="$2"; shift;;
    --reachable) want_reach=1;;
  esac
  shift
done
unreach=",${FAKE_FLEET_UNREACH:-},"
n="${FAKE_FLEET_ROWS:-8}"
words="one two three four five six seven eight nine ten eleven twelve thirteen"
rows() {
  i=1
  while [ "$i" -le "$n" ]; do
    w="$(printf '%s\n' $words | sed -n "${i}p")"; [ -n "$w" ] || w="s$i"
    # Rows 1 and 4 are `blocked` (waiting on you); the rest are working.
    st=working; case "$i" in 1|4) st=blocked;; esac
    # Row 1 sits in the project, the rest in $HOME, so the cwd-narrowing paths differ.
    d="$HOME"; [ "$i" -le 2 ] && d="$HOME/Coding/your_other_project"
    nm="$w $st"
    if [ "${FAKE_FLEET_DUPS:-0}" = 1 ] && { [ "$i" = 2 ] || [ "$i" = 3 ]; }; then nm="same name"; fi
    if [ "${FAKE_FLEET_DUPS:-0}" = edge ] && { [ "$i" = 1 ] || [ "$i" = "$n" ]; }; then nm="same name"; fi
    ok=1
    case "$unreach" in *",$i,"*) ok=0 ;; esac
    # --reachable FILTERS, it does not merely annotate: an unreachable session has
    # no socket to write into, so it must not reach a pane at all.
    if [ "$ok" = 0 ] && [ "$want_reach" = 1 ]; then i=$((i + 1)); continue; fi
    printf 'aaaaaaa%s\t%s\t%s\t%s\t%s\t%s\n' "$i" "$st" "$ok" "$((i + 1))" "$d" "$nm"
    i=$((i + 1))
  done
}
if [ "$max" -gt 0 ]; then rows | head -n "$max"; else rows; fi
